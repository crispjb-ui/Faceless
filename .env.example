# ---- Core ----
# Active niche id (see faceless/niches/registry.py)
FACELESS_NICHE=self_improvement
# SQLAlchemy URL. SQLite for local; swap to postgresql://... for prod.
DATABASE_URL=sqlite:///data/faceless.sqlite
# Where rendered assets / videos are written
OUTPUT_DIR=output
# Render backend: "ffmpeg" (slideshow, zero extra deps) or "remotion" (branded).
RENDER_BACKEND=ffmpeg
# Root folder holding pre-licensed music; per-niche subfolders (e.g. cinematic_ambient/).
MUSIC_LIBRARY_DIR=music

# ---- Funnel / brand ----
# Brand name used on the lead magnet, journal, emails, and landing page.
BRAND_NAME=Daily Discipline
# Your bio link (Stan.store URL) — the landing page CTA and emails point here.
STORE_URL=

# ---- LLM (ideation, scripting, compliance) ----
ANTHROPIC_API_KEY=
# Model used for high-volume scripting; Opus for harder reasoning steps.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_HEAVY=claude-opus-4-7

# ---- YouTube ----
# API key is enough for DISCOVERY (read-only search/videos.list).
YOUTUBE_API_KEY=
# OAuth client (Desktop app) is required for UPLOAD (videos.insert).
# Download client_secret.json from Google Cloud console; path below.
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
# After first OAuth consent the refresh token is cached here.
YOUTUBE_TOKEN_FILE=youtube_token.json

# ---- Voiceover (TTS) ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Visuals ----
# Flux on fal.ai — your fal API key (used as FAL_KEY).
IMAGE_API_KEY=
# Optional AI motion (Runway/Luma/Kling/Veo) key.
VIDEO_API_KEY=

# ---- Music ----
# Music is selected from MUSIC_LIBRARY_DIR (populate it with commercially-cleared
# tracks, e.g. Epidemic Sound downloads). This key is only needed if you later
# wire a music *API* instead of the local library.
MUSIC_API_KEY=

# ---- Multi-platform distribution ----
# Posting API/SaaS token (upload-post / Blotato / Postiz / Metricool / Buffer).
DISTRIBUTION_API_KEY=

# ---- Object storage (S3-compatible; Cloudflare R2 recommended) ----
# When set, rendered videos are uploaded here and the public URL is used as the
# media source for distribution (avoids re-uploading to the posting provider).
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public base URL that serves the bucket (e.g. https://media.yourdomain.com or an r2.dev URL).
STORAGE_PUBLIC_BASE_URL=
# R2 uses "auto"; for AWS S3 use the bucket region (e.g. us-east-1).
STORAGE_REGION=auto
